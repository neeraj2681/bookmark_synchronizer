# Database Configuration
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=5432
DB_NAME=bookmark_sync
DB_USER=your-db-username
DB_PASSWORD=your-db-password

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-token-secret-different-from-jwt-secret
REFRESH_TOKEN_EXPIRES_IN=7d

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET_NAME=bookmark-sync-bucket

# Server Configuration
PORT=3000
NODE_ENV=development

# Example production values:
# NODE_ENV=production
# DB_HOST=prod-bookmark-db.xyz123.us-east-1.rds.amazonaws.com
# JWT_SECRET=prod-secret-key-should-be-very-long-and-random
# S3_BUCKET_NAME=prod-bookmark-sync-bucket 